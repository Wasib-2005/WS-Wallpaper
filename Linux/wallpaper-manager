            tk.Label(detail, text=image_details, bg=CARD_ALT,
                     fg=MUTED, font=("TkDefaultFont", 9)).pack(anchor="w", pady=(3, 0))
            self.button(row, "Delete", lambda image=path: self.delete_image(image),
