    def show_page(self, name):
        self.disable_mousewheel_scroll()
        self.page = name
        for child in self.body.winfo_children():
            child.destroy()
        self.page_title.configure(text=name)
        for nav_name, button in self.nav_buttons.items():
            active = nav_name == name
            button.configure(bg=CARD_ALT if active else SIDEBAR,
                             fg=ACCENT if active else MUTED,
                             activebackground=CARD_ALT, activeforeground=TEXT)
        if name == "Overview":
            self.build_overview()
        elif name == "Library":
            self.build_library()
        elif name == "Preferences":
            self.build_preferences()
        else:
            self.build_activity()
        if name == "Overview":
            self.refresh_overview()

