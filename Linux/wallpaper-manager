    def browse_save_dir(self):
        initial_dir = os.path.expanduser(self.save_dir_var.get() or SAVE_DIR)
        desktop = os.environ.get("XDG_CURRENT_DESKTOP", "").lower()
        chooser = shutil.which("kdialog") if "kde" in desktop else None
        chooser = chooser or shutil.which("zenity")
        chooser = chooser or shutil.which("kdialog")

        try:
            if chooser:
                if os.path.basename(chooser) == "kdialog":
                    command = [
                        chooser, "--getexistingdirectory", initial_dir,
                        "--title", "Choose wallpaper folder",
                    ]
                else:
                    command = [
                        chooser, "--file-selection", "--directory",
                        "--title=Choose wallpaper folder",
                        f"--filename={initial_dir.rstrip(os.sep)}/",
                    ]
                result = subprocess.run(
                    command, capture_output=True, text=True, timeout=300, check=False,
                )
                if result.returncode == 1:
                    return
                if result.returncode != 0:
                    raise RuntimeError(
                        result.stderr.strip() or "The desktop folder chooser could not open."
                    )
                selected = result.stdout.strip()
            else:
                selected = filedialog.askdirectory(
                    parent=self.root,
                    title="Choose wallpaper folder",
                    initialdir=initial_dir,
                    mustexist=False,
                )
        except (OSError, subprocess.TimeoutExpired, RuntimeError) as error:
            messagebox.showerror("Could not open folder chooser", str(error), parent=self.root)
            return

        if selected:
            self.save_dir_var.set(selected)

    def add_clock_input(self, parent, title, variables, row, column):
        field = tk.Frame(parent, bg=CARD)
        field.grid(row=row, column=column, sticky="w", padx=5, pady=5)
        tk.Label(field, text=title, bg=CARD, fg=MUTED,
                 font=("TkDefaultFont", 9)).pack(anchor="w", pady=(0, 6))
        clock = tk.Frame(field, bg=CARD)
        clock.pack(anchor="w")
        self.clock_fields = []
        for index, variable in enumerate(variables):
            entry = tk.Entry(
                clock, width=4 if index == 0 else 2, textvariable=variable,
                justify="center",
                bg=CARD_ALT, fg=TEXT, insertbackground=ACCENT,
                relief="flat", bd=0,
                highlightthickness=1, highlightbackground=BORDER,
                highlightcolor=ACCENT, font=("TkFixedFont", 12),
            )
            entry.pack(side="left", ipady=8)
            self.clock_fields.append(entry)
            entry.bind("<FocusIn>", lambda event: event.widget.selection_range(0, "end"))
            entry.bind(
                "<FocusOut>",
                lambda _event, part=index: self.normalize_clock_segment(part),
            )
            entry.bind(
                "<KeyRelease>",
                lambda event, part=index: self.advance_clock_on_complete(event, part),
            )
            entry.bind("<Return>", lambda _event, part=index: self.focus_clock_segment(part + 1))
            entry.bind(
                "<Up>",
                lambda _event, part=index: self.step_clock_segment(part, 1),
            )
            entry.bind(
                "<Down>",
                lambda _event, part=index: self.step_clock_segment(part, -1),
            )
            if index < len(variables) - 1:
                tk.Label(clock, text=":", bg=CARD, fg=CYAN,
                         font=("TkFixedFont", 13, "bold")).pack(side="left", padx=5)
        for entry in self.clock_fields:
            entry.bind(
                "<Left>",
                lambda _event, current=entry: self.focus_adjacent_clock_segment(current, -1),
            )
            entry.bind(
                "<Right>",
                lambda _event, current=entry: self.focus_adjacent_clock_segment(current, 1),
            )
        parent.grid_columnconfigure(column, weight=1)

    def normalize_clock_segment(self, index):
        value = self.timer_vars[index].get().strip()
        if value.isascii() and value.isdigit():
            self.timer_vars[index].set(value.zfill(2))
        elif not value:
            self.timer_vars[index].set("00")

    def step_clock_segment(self, index, amount):
        value = self.timer_vars[index].get().strip()
        if not value.isascii() or not value.isdigit():
            value = "0"
        maximum = 999999 if index == 0 else 59
        updated = (int(value) + amount) % (maximum + 1)
        self.timer_vars[index].set(f"{updated:02d}")
        return "break"

    def advance_clock_on_complete(self, event, index):
        if event.keysym in ("Left", "Right", "Up", "Down", "Tab", "Return"):
            return
        value = self.timer_vars[index].get()
        if value.isascii() and value.isdigit() and len(value) >= 2:
            self.normalize_clock_segment(index)
            self.focus_clock_segment(index + 1)

    def focus_clock_segment(self, index):
        if index < len(self.clock_fields):
            next_field = self.clock_fields[index]
            next_field.focus_set()
            next_field.selection_range(0, "end")

    def focus_adjacent_clock_segment(self, current, direction):
        try:
            index = self.clock_fields.index(current)
        except ValueError:
            return
        next_index = index + direction
        if 0 <= next_index < len(self.clock_fields):
            self.normalize_clock_segment(index)
            self.focus_clock_segment(next_index)
            return "break"

