    def apply_selected_theme(self, _event=None):
        selected = self.theme_var.get()
        selected_style = self.ui_style_var.get()
        if selected not in THEME_PALETTES or selected_style not in UI_STYLE_NAMES:
            return
        color_names = (
            "BG", "SIDEBAR", "CARD", "CARD_ALT", "ACCENT", "ACTIVE_PRIMARY",
            "PRIMARY_TEXT", "CYAN", "TEXT", "MUTED", "BORDER",
        )
        previous_colors = {name: globals()[name] for name in color_names}
        set_ui_style(selected_style)
        set_theme_palette(selected)
        color_map = {
            previous_colors[name]: globals()[name]
            for name in color_names
        }
        border_color = UI_STYLE_BORDER_COLORS.get(selected_style, BORDER)
        if border_color == "accent":
            border_color = ACCENT

        def recolor(widget):
            for option in (
                "bg", "fg", "activebackground", "activeforeground",
                "highlightbackground", "highlightcolor", "insertbackground",
                "selectbackground", "selectcolor", "troughcolor",
            ):
                try:
                    old_color = widget.cget(option)
                    new_color = color_map.get(old_color)
                    if new_color is not None:
                        widget.configure(**{option: new_color})
                except tk.TclError:
                    continue
            for child in widget.winfo_children():
                recolor(child)
            if getattr(widget, "_wallpaper_card", False):
                relief, border_width, highlight_width = UI_STYLE_CARD_STYLES.get(
                    selected_style, ("flat", 0, 0)
                )
                widget.configure(
                    relief=relief, bd=border_width,
                    highlightthickness=highlight_width,
                    highlightbackground=border_color,
                )
            elif getattr(widget, "_wallpaper_button", False):
                relief, border_width = UI_STYLE_BUTTON_STYLES.get(
                    selected_style, ("flat", 0)
                )
                highlight_width = 1 if selected_style in (
                    "Glassmorphism", "Skeuomorphism", "Retro-Futuristic / Cyberpunk"
                ) else 0
                widget.configure(
                    relief=relief, bd=border_width,
                    highlightthickness=highlight_width,
                    highlightbackground=border_color,
                )

        recolor(self.root)
        self.root.configure(bg=BG)
        self.configure_styles()
        self.apply_contrast_to_tree(self.root)
        for name, button in self.nav_buttons.items():
            self.style_navigation_button(button, name == self.page)
        if hasattr(self, "theme_description") and self.theme_description.winfo_exists():
            self.theme_description.configure(
                text=THEME_DESCRIPTIONS.get(selected, f"{selected.title()} color palette.")
            )
        if hasattr(self, "ui_style_description") and self.ui_style_description.winfo_exists():
            self.ui_style_description.configure(text=UI_STYLE_DESCRIPTIONS[selected_style])
        if hasattr(self, "layout_preview_title") and self.layout_preview_title.winfo_exists():
            self.layout_preview_title.configure(
                text=f"DASHBOARD PREVIEW  /  {selected_style.upper()}"
            )
        if hasattr(self, "layout_preview") and self.layout_preview.winfo_exists():
            self.draw_layout_preview()

    def persist_theme(self):
        theme = self.theme_var.get()
        if theme not in THEME_PALETTES:
            raise ValueError(f"Unknown color theme: {theme}")
        ui_style = self.ui_style_var.get()
        if ui_style not in UI_STYLE_NAMES:
            raise ValueError(f"Unknown UI style: {ui_style}")
        config = self.load_config()
        config["theme"] = theme
        config["ui_style"] = ui_style
        os.makedirs(CONFIG_DIR, exist_ok=True)
        temporary_file = CONFIG_FILE + ".tmp"
        try:
            with open(temporary_file, "w", encoding="utf-8") as config_file:
                json.dump(config, config_file, indent=4)
            os.replace(temporary_file, CONFIG_FILE)
        except OSError as error:
            raise RuntimeError(f"Could not save the color theme: {error}") from error

