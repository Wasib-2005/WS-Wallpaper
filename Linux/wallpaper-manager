    def get_preferences(self):
        try:
            timer = self.parse_timer(":".join(variable.get() for variable in self.timer_vars))
            keep = int(self.keep_var.get())
        except ValueError as error:
            raise ValueError(
                "Enter rotation time as HH:MM:SS (for example, 00:30:00) and image count as a whole number."
            ) from error
        if keep < 0:
            raise ValueError("Image count cannot be negative.")
        purity = "".join("1" if self.purity_vars[name].get() else "0"
                         for name in ("SFW", "Sketchy", "NSFW"))
        categories = "".join("1" if self.category_vars[name].get() else "0"
                             for name in ("General", "Anime", "People"))
        if "1" not in purity or "1" not in categories:
            raise ValueError("Select at least one content filter and one category.")
        save_dir = os.path.abspath(os.path.expanduser(self.save_dir_var.get().strip()))
        if not self.save_dir_var.get().strip():
            raise ValueError("Choose a folder for downloaded wallpapers.")
        return [
            ("--query", self.query_var.get().strip()),
            ("--resolution", self.resolution_var.get().strip()),
            ("--ratio", self.ratio_var.get().strip()),
            ("--sort", self.sort_var.get()),
            ("--top-range", self.top_range_var.get()),
            ("--purity", purity),
            ("--categories", categories),
            ("--key", self.key_var.get().strip()),
            ("--timer", str(timer)),
            ("--keep", str(keep)),
            ("--save-dir", save_dir),
        ]

    @staticmethod
    def parse_timer(value):
        parts = value.strip().split(":")
        if (len(parts) != 3 or len(parts[0]) < 2 or len(parts[1]) != 2
                or len(parts[2]) != 2
                or any(not part.isascii() or not part.isdigit() for part in parts)):
            raise ValueError("Rotation time must use HH:MM:SS.")
        hours, minutes, seconds = (int(part) for part in parts)
        if minutes > 59 or seconds > 59:
            raise ValueError("Minutes and seconds must be between 00 and 59.")
        total_seconds = hours * 3600 + minutes * 60 + seconds
        if total_seconds == 0:
            raise ValueError("Rotation time must be greater than 00:00:00.")
        return total_seconds / 60

    @staticmethod
    def format_timer(value):
        try:
            total_seconds = max(1, round(float(value) * 60))
        except (TypeError, ValueError, OverflowError):
            total_seconds = 1800
        hours, remainder = divmod(total_seconds, 3600)
        minutes, seconds = divmod(remainder, 60)
        return f"{hours:02d}:{minutes:02d}:{seconds:02d}"

    def save_preferences(self):
        try:
            options = self.get_preferences()
        except ValueError as error:
            messagebox.showerror("Check your preferences", str(error), parent=self.root)
            return
        args = [part for key, value in options for part in (key, value)] + ["--set"]
        def done(_output):
            self.config = self.load_config()
            self.save_dir = os.path.abspath(os.path.expanduser(
                str(self.config.get("save_dir", SAVE_DIR))
            ))
            self.status_text.set("Preferences saved")
            self.show_page("Preferences")
            self.refresh_overview()
            messagebox.showinfo("Saved", "Your preferences have been saved.", parent=self.root)
        self.run_cli(args, "Saving preferences…", done)

    def change_now(self):
        self.run_cli(["--status"], "Checking wallpaper service…",
                     lambda output: self._change_now(output))

    def _change_now(self, output):
        if "RUNNING" in output:
            self.run_cli(["--now"], "Asking the service for a new wallpaper…",
                         lambda _result: self.refresh_after_request())
        else:
            self.run_cli(["--once"], "Finding and applying a wallpaper…",
                         self.after_action)

    def refresh_after_request(self):
        self.status_text.set("Wallpaper refresh requested")
        self.root.after(3000, self.refresh_overview)

    def start_service(self):
        try:
            options = self.get_preferences()
        except ValueError as error:
            messagebox.showerror("Check your preferences", str(error), parent=self.root)
            return
        args = [part for key, value in options for part in (key, value)] + ["--daemon"]
        self.run_cli(args, "Starting automatic rotation…",
                     lambda _output: self.save_service_settings())

    def stop_service(self):
        self.run_cli(["--stop"], "Stopping automatic rotation…",
                     lambda _output: self.set_service_state(False))

    def set_service_state(self, running):
        self.status_text.set("Rotation started" if running else "Rotation stopped")
        self.refresh_service()

    def run_cli(self, args, message, on_success=None):
        self.status_text.set(message)

        def work():
            try:
                options = {}
                if os.name == "nt":
                    options["creationflags"] = getattr(subprocess, "CREATE_NO_WINDOW", 0)
                result = subprocess.run([self.cli, *args], capture_output=True,
                                        text=True, timeout=45, check=False, **options)
                output = (result.stdout + result.stderr).strip()
                if result.returncode != 0:
                    raise RuntimeError(output or f"Command exited with status {result.returncode}.")
                self.root.after(0, lambda: self.command_succeeded(output, on_success))
            except (OSError, subprocess.TimeoutExpired, RuntimeError) as error:
                self.root.after(0, lambda error=error: self.command_failed(error))

        threading.Thread(target=work, daemon=True).start()

    def command_succeeded(self, output, on_success):
        self.status_text.set("Ready")
        if on_success:
            on_success(output)
        self.refresh_service()
        self.refresh_overview()

    def command_failed(self, error):
        self.status_text.set("Action failed")
        messagebox.showerror("Wallpaper Manager", str(error), parent=self.root)

    def after_action(self, output):
        if "❌" in output or "⚠️" in output:
            self.status_text.set("Wallpaper action completed with a warning; see Activity")
            messagebox.showwarning(
                "Wallpaper action completed with a warning",
                "The wallpaper command reported an issue. Check Activity for details.",
                parent=self.root,
            )
        else:
            self.status_text.set("Wallpaper updated")

    def save_service_settings(self):
        self.config = self.load_config()
        self.save_dir = os.path.abspath(os.path.expanduser(
            str(self.config.get("save_dir", SAVE_DIR))
        ))
        self.set_service_state(True)

    def refresh_service(self):
        if self.service_check_running:
            return
        self.service_check_running = True

        def work():
            try:
                options = {}
                if os.name == "nt":
                    options["creationflags"] = getattr(subprocess, "CREATE_NO_WINDOW", 0)
                result = subprocess.run([self.cli, "--status"], capture_output=True,
                                        text=True, timeout=10, check=False, **options)
                output = result.stdout + result.stderr
                running = "RUNNING" in output
                error = output.strip() if result.returncode != 0 else None
            except (OSError, subprocess.TimeoutExpired) as caught:
                running, error = False, str(caught)
            self.root.after(0, lambda: self.update_service(running, error))
        threading.Thread(target=work, daemon=True).start()

    def update_service(self, running, error):
        self.service_check_running = False
        if hasattr(self, "service_text"):
            self.service_text.set("Running" if running else "Not running")
            self.service_label.configure(fg=ACCENT if running else MUTED)
        if error:
            self.status_text.set(error)

    def poll_service(self):
        self.refresh_service()
        if self.page == "Activity":
            self.refresh_logs()
        self.root.after(5000, self.poll_service)

    def open_library(self):
        try:
            os.makedirs(self.save_dir, exist_ok=True)
        except OSError as error:
            messagebox.showerror("Could not open wallpaper folder", str(error), parent=self.root)
            return
        self.open_path(self.save_dir)

    def open_image(self, path):
        if os.name == "nt":
            try:
                os.startfile(path)
            except OSError as error:
                messagebox.showerror(
                    "Could not show wallpaper",
                    f"No image viewer could be opened for this file:\n{error}",
                    parent=self.root,
                )
            return
        try:
            subprocess.Popen(["xdg-open", path], stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
        except OSError as error:
            messagebox.showerror(
                "Could not show wallpaper",
                f"No image viewer could be opened for this file:\n{error}",
                parent=self.root,
            )

    @staticmethod
    def open_path(path):
        if os.name == "nt":
            try:
                os.startfile(path)
            except OSError as error:
                messagebox.showerror("Could not open", str(error))
            return
        try:
            subprocess.Popen(["xdg-open", path], stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
        except OSError as error:
            messagebox.showerror("Could not open", str(error))


def main():
    try:
        root = tk.Tk()
        WallpaperManager(root)
        root.mainloop()
    except (FileNotFoundError, RuntimeError) as error:
        messagebox.showerror("Wallpaper Manager", str(error))
        sys.exit(1)


if __name__ == "__main__":
    main()
