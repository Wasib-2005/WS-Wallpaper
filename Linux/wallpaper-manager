    def refresh_overview(self):
        if self.page != "Overview":
            return
        images = self.images()
        count = len(images)
        self.collection_label.configure(text=f"{count} saved wallpaper{'s' if count != 1 else ''}")
        self.stat_count.winfo_children()[-1].configure(text=f"{count} wallpaper{'s' if count != 1 else ''}")
        timer = self.config.get("timer")
        try:
            timer_text = f"Every {float(timer):g} minutes" if timer and float(timer) > 0 else "Not scheduled"
        except (TypeError, ValueError):
            timer_text = "Not scheduled"
        self.stat_schedule.winfo_children()[-1].configure(text=timer_text)
        resolution = str(self.config.get("resolution", "1920x1080")).replace("x", " × ")
        self.stat_quality.winfo_children()[-1].configure(text=resolution)
        self.schedule_label.configure(text=timer_text)
        if images:
            current = images[0]
            self.preview_label.configure(
                image="", text=f"✦  LATEST WALLPAPER\n\n{os.path.basename(current)}\n\n{self.human_size(os.path.getsize(current))}  ·  {count} saved",
                bg=CARD_ALT, fg=TEXT, font=("TkDefaultFont", 12, "bold"),
            )
            self.preview_label.image = None
            try:
                from PIL import Image, ImageTk
                with Image.open(current) as image:
                    image.thumbnail((850, 280))
                    photo = ImageTk.PhotoImage(image)
                self.preview_label.configure(image=photo, text="", bg=CARD)
                self.preview_label.image = photo
            except ImportError:
                pass
            except OSError:
                self.preview_label.configure(text=f"Latest wallpaper\n\n{os.path.basename(current)}",
                                             image="", bg=CARD_ALT)

    def images(self):
        if not os.path.isdir(self.save_dir):
            return []
        try:
            paths = [
                os.path.join(self.save_dir, name) for name in os.listdir(self.save_dir)
                if name.lower().endswith(IMAGE_EXTS)
                and os.path.isfile(os.path.join(self.save_dir, name))
            ]
        except OSError as error:
            self.status_text.set(f"Could not read library: {error}")
            return []
        return sorted(paths, key=os.path.getmtime, reverse=True)

    @staticmethod
    def human_size(size):
        if size >= 1024 * 1024:
            return f"{size / (1024 * 1024):.1f} MB"
        return f"{size / 1024:.0f} KB"

    def enable_canvas_scroll(self, canvas, content, window_id):
        self.scroll_canvas = canvas
        content.bind(
            "<Configure>",
            lambda _event: canvas.configure(scrollregion=canvas.bbox("all")),
        )
        canvas.bind(
            "<Configure>",
            lambda event: canvas.itemconfigure(window_id, width=event.width),
        )
    def disable_mousewheel_scroll(self):
        self.scroll_canvas = None

    def on_mousewheel(self, event):
        canvas = self.scroll_canvas
        if canvas is None or not canvas.winfo_exists():
            return
        pointer_x, pointer_y = self.root.winfo_pointerxy()
        left, top = canvas.winfo_rootx(), canvas.winfo_rooty()
        if not (left <= pointer_x < left + canvas.winfo_width()
                and top <= pointer_y < top + canvas.winfo_height()):
            return
        if getattr(event, "num", None) == 4:
            units = -1
        elif getattr(event, "num", None) == 5:
            units = 1
        else:
            delta = getattr(event, "delta", 0)
            units = -1 if delta > 0 else 1
            if abs(delta) >= 120:
                units *= max(1, abs(delta) // 120)
        canvas.yview_scroll(units, "units")
        return "break"

