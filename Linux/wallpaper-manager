                text = "Nothing here yet. Recent wallpaper activity will show up once the service runs."
            else:
                with open(LOG_FILE, "r", encoding="utf-8", errors="replace") as log_file:
                    text = "".join(deque(log_file, maxlen=150)).strip() or "No activity recorded yet."
        except OSError as error:
            text = f"Could not read the activity log: {error}"
        if hasattr(self, "log_text") and self.log_text.winfo_exists():
            self.log_text.configure(state="normal")
            self.log_text.delete("1.0", "end")
