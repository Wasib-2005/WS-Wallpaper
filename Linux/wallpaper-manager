def make_palette(bg, surface, accent, text, muted, border, *,
                 sidebar=None, secondary=None, active=None, cyan=None,
                 primary_text=None):
    return {
        "BG": bg,
        "SIDEBAR": sidebar or bg,
        "CARD": surface,
        "CARD_ALT": secondary or surface,
        "ACCENT": accent,
        "ACTIVE_PRIMARY": active or accent,
        "PRIMARY_TEXT": primary_text or bg,
        "CYAN": cyan or accent,
        "TEXT": text,
        "MUTED": muted,
        "BORDER": border,
    }


def color_luminance(color):
    if not isinstance(color, str) or not re.fullmatch(r"#[0-9a-fA-F]{6}", color):
        return None
    channels = [int(color[index:index + 2], 16) / 255 for index in (1, 3, 5)]
    linear = [
        channel / 12.92 if channel <= 0.04045
        else ((channel + 0.055) / 1.055) ** 2.4
        for channel in channels
    ]
    return 0.2126 * linear[0] + 0.7152 * linear[1] + 0.0722 * linear[2]


def contrast_ratio(foreground, background):
    foreground_luminance = color_luminance(foreground)
    background_luminance = color_luminance(background)
    if foreground_luminance is None or background_luminance is None:
        return None
    lighter, darker = sorted((foreground_luminance, background_luminance), reverse=True)
    return (lighter + 0.05) / (darker + 0.05)


def contrast_safe_color(foreground, background, minimum=4.5):
    ratio = contrast_ratio(foreground, background)
    if ratio is None or ratio >= minimum:
        return foreground
    return max(("#000000", "#ffffff"), key=lambda color: contrast_ratio(color, background))


