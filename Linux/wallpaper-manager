    @staticmethod
    def image_dimensions(path):
        try:
            from PIL import Image
        except ImportError:
            return "image"
        with Image.open(path) as image:
            return f"{image.width} × {image.height}"

    def show_wallpaper(self, path):
        try:
            from PIL import Image, ImageTk
        except ImportError:
            self.open_image(path)
            return

        try:
            with Image.open(path) as image:
                original_size = image.size
                image.thumbnail((1000, 700))
                photo = ImageTk.PhotoImage(image)
        except OSError as error:
            messagebox.showerror("Could not show wallpaper", str(error), parent=self.root)
            return

        preview = tk.Toplevel(self.root)
        preview.title(os.path.basename(path))
        preview.configure(bg=BG)
        preview.transient(self.root)
        preview.geometry(f"{max(500, photo.width() + 40)}x{max(360, photo.height() + 90)}")
        tk.Label(preview, text=os.path.basename(path), bg=BG, fg=TEXT,
                 font=("TkDefaultFont", 11, "bold")).pack(padx=18, pady=(14, 3))
        tk.Label(preview, text=f"{original_size[0]} × {original_size[1]}  ·  {self.human_size(os.path.getsize(path))}",
                 bg=BG, fg=MUTED, font=("TkDefaultFont", 9)).pack(pady=(0, 12))
        image_label = tk.Label(preview, image=photo, bg=BG)
        image_label.image = photo
        image_label.pack(padx=18, pady=(0, 18), expand=True)

    def delete_image(self, path):
        if not messagebox.askyesno(
            "Delete wallpaper?",
            f"Delete {os.path.basename(path)} from your library?\n\nThis cannot be undone.",
            parent=self.root,
        ):
            return
        try:
            os.remove(path)
        except OSError as error:
            messagebox.showerror("Could not delete wallpaper", str(error), parent=self.root)
            return
        self.status_text.set(f"Deleted {os.path.basename(path)}")
        self.show_page("Library")

