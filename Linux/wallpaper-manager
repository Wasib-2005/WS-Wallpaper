def find_cli():
    if getattr(sys, "frozen", False):
        app_dir = os.path.dirname(sys.executable)
        sibling = os.path.join(app_dir, "wallpaper.exe" if os.name == "nt" else "wallpaper")
        if os.path.isfile(sibling):
            return sibling
    else:
        sibling = os.path.join(os.path.dirname(os.path.abspath(__file__)), "wallpaper")
        if os.path.isfile(sibling):
            return sibling
    installed = shutil.which("wallpaper")
    if installed:
        return installed
    raise FileNotFoundError("Could not find the 'wallpaper' command beside this app or on PATH.")


class WallpaperManager:
    def __init__(self, root):
        self.root = root
        self.cli = find_cli()
        self.config = self.load_config()
        saved_theme = self.config.get("theme", "forest")
        legacy_style = saved_theme if saved_theme in UI_STYLE_NAMES else None
        set_ui_style(self.config.get("ui_style", legacy_style or "Flat Design"))
        set_theme_palette("Forest" if legacy_style else saved_theme)
        configured_dir = self.config.get("save_dir", SAVE_DIR)
        self.save_dir = os.path.abspath(os.path.expanduser(str(configured_dir)))
        self.page = "Overview"
        self.scroll_canvas = None
        self.service_check_running = False
        self.update_check_running = False
        self.status_text = tk.StringVar(value="Ready")
        self.service_text = tk.StringVar(value="Checking service…")
        self.update_status = tk.StringVar(value=f"Version {APP_VERSION}")
        self.purity_vars = {}
        self.category_vars = {}
        self.saved_preference_snapshot = None

        root.title("WS Wallpaper")
        root.geometry("1120x760")
        root.minsize(900, 640)
        root.configure(bg=BG)
        root.protocol("WM_DELETE_WINDOW", self.close_window)
        self.configure_styles()
        self.set_window_icon()
        self.build_shell()
        for sequence in ("<MouseWheel>", "<Button-4>", "<Button-5>"):
            self.root.bind_all(sequence, self.on_mousewheel, add="+")
        self.show_page("Overview")
        self.root.after(5000, self.poll_service)
        self.root.after(1000, lambda: self.check_for_updates(manual=False))

    def configure_styles(self):
        style = ttk.Style()
        style.theme_use("clam")
        combo_text = contrast_safe_color(TEXT, CARD_ALT)
        style.configure("TCombobox", fieldbackground=CARD_ALT, background=CARD_ALT,
                        foreground=combo_text,
                        arrowcolor=contrast_safe_color(ACCENT, CARD_ALT),
                        bordercolor=BORDER,
                        lightcolor=BORDER, darkcolor=BORDER, padding=9)
        style.map("TCombobox", fieldbackground=[("readonly", CARD_ALT)],
                  foreground=[("readonly", combo_text)],
                  selectbackground=[("readonly", CARD_ALT)],
                  selectforeground=[("readonly", combo_text)])
        style.configure("Vertical.TScrollbar", background=CARD_ALT,
                        troughcolor=BG,
                        arrowcolor=contrast_safe_color(MUTED, BG), bordercolor=BG)

    def icon_path(self):
        candidates = (
            os.path.join(
                os.path.expanduser("~/.local/share/icons/hicolor/512x512/apps"),
                "ws-wallpaper.png",
            ),
            os.path.join(os.path.dirname(os.path.abspath(__file__)), "ws-wallpaper.png"),
        )
        return next((path for path in candidates if os.path.isfile(path)), None)

    def set_window_icon(self):
        path = self.icon_path()
        if path is None:
            return
        try:
            from PIL import Image, ImageTk
            with Image.open(path) as image:
                self.window_icon = ImageTk.PhotoImage(image.resize((64, 64)))
            self.root.iconphoto(True, self.window_icon)
        except (OSError, tk.TclError) as error:
            self.status_text.set(f"Could not load app icon: {error}")

    def load_config(self):
        if not os.path.exists(CONFIG_FILE):
            config = dict(DEFAULT_CONFIG)
            os.makedirs(CONFIG_DIR, exist_ok=True)
            temporary_file = CONFIG_FILE + ".tmp"
            try:
                with open(temporary_file, "w", encoding="utf-8") as config_file:
                    json.dump(config, config_file, indent=4)
                os.replace(temporary_file, CONFIG_FILE)
            except OSError as error:
                raise RuntimeError(
                    f"Could not create default settings at {CONFIG_FILE}: {error}"
                ) from error
            return config
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as config_file:
                config = json.load(config_file)
        except (OSError, json.JSONDecodeError) as error:
            raise RuntimeError(f"Could not read settings at {CONFIG_FILE}: {error}") from error
        if not isinstance(config, dict):
