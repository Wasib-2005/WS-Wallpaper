    @staticmethod
    def apply_widget_contrast(widget):
        for foreground_option, background_option in (
            ("fg", "bg"),
            ("activeforeground", "activebackground"),
            ("selectforeground", "selectbackground"),
            ("insertbackground", "bg"),
        ):
            try:
                foreground = widget.cget(foreground_option)
                background = widget.cget(background_option)
                readable_foreground = contrast_safe_color(foreground, background)
                if readable_foreground != foreground:
                    widget.configure(**{foreground_option: readable_foreground})
            except tk.TclError:
                continue

    @classmethod
    def apply_contrast_to_tree(cls, widget):
        cls.apply_widget_contrast(widget)
        for child in widget.winfo_children():
            cls.apply_contrast_to_tree(child)

