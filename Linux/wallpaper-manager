def prepare_config_dir():
    if os.name == "nt":
        return os.path.join(
            os.environ.get("APPDATA", os.path.expanduser("~/AppData/Roaming")),
            "Wallhaven",
        )
    config_dir = os.path.expanduser("~/.config/ws-wallpaper")
    legacy_dir = os.path.expanduser("~/.config/wallhaven")
    if os.path.isdir(legacy_dir) and not os.path.exists(config_dir):
        try:
            os.makedirs(os.path.dirname(config_dir), exist_ok=True)
            os.replace(legacy_dir, config_dir)
        except FileNotFoundError:
            if not os.path.exists(config_dir):
                raise
        except OSError as error:
            raise RuntimeError(
                f"Could not move existing settings from {legacy_dir} to {config_dir}: {error}"
            ) from error
    return config_dir


